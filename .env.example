# Browser values: use the Supabase project URL and anon/public key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only values: never prefix secrets with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
INTAKE_RATE_LIMIT_SECRET=your-random-rate-limit-secret
CRON_SECRET=your-random-cron-secret
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CHANNEL_ID=your-youtube-channel-id

# Vercel supplies this automatically for linked deployments; do not set locally.
VERCEL_OIDC_TOKEN=provided-by-vercel-at-runtime
